# Required: private Google AI Studio key; never commit a real value.
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-your-private-key
# Required: isolated development database only. Replace privately after selection.
DATABASE_URL=postgresql://DEV_USER:DEV_PASSWORD@localhost:5432/docrag_dev
# Optional reserved production setting; never used by Step 0 helpers.
DATABASE_URL_PROD=
# Opaque database sessions; no JWT secret is used.

# Optional local mode; Gemini remains the default. See docs/LOCAL_OLLAMA.md.
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_DATABASE_URL=postgresql://DEV_USER:DEV_PASSWORD@127.0.0.1:55432/docrag_ollama_v1

# Optional server-local MiniLM reranker (Step 5); retained disabled by default.
# Set an absolute path only after running the documented local installer.
RERANKER_ENABLED=false
RERANKER_CANDIDATES=10
RERANKER_DEVICE=cpu
RERANKER_TIMEOUT_MS=15000
# DOCRAG_RERANKER_HOME=/absolute/path/to/RAG-Agent/.local/reranker-minilm

# Step 6: public evaluation corpus only; private uploads always bypass storage.
RESPONSE_CACHE_ENABLED=false
RAG_PROMPT_VERSION=step5-v1

# Step 7 authentication: generate privately; never commit the real value.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DOCRAG_APP_ORIGIN=http://localhost:8000
# Explicit loopback-only development exception. Use HTTPS and false online.
DOCRAG_LOCAL_HTTP=true

# Local native PostgreSQL port; must match private connection settings.
DOCRAG_POSTGRES_PORT=55432

# Optional hosted public demo. Keep local settings above for local development.
# DOCRAG_DEPLOYMENT=recruiter-demo
# AI_PROVIDER=gemini
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=replace-privately-never-commit
# DEMO_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/docrag_demo_gemini_v1?sslmode=verify-full
# Set only after the owner confirms the same key's project has no linked billing account:
# DOCRAG_GEMINI_BILLING_CONFIRMED=no-linked-account
# RERANKER_ENABLED=false
# RESPONSE_CACHE_ENABLED=false
